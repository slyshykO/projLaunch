<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <XmlResolverIsNetworkingEnabledByDefault>false</XmlResolverIsNetworkingEnabledByDefault>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0' Or '$(TargetFramework)' == 'net11.0'">
    <LangVersion>preview</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="obj/hashes.fs" />
    <Compile Include="SelfBuild.fs" />
    <Compile Include="Print.fs" />
    <Compile Include="../scripts/version/Versioning.fs" />
    <Compile Include="GitServerUbuntu22.fs" />
    <Compile Include="GitServer.fs" />
    <Compile Include="Publish.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="scripts/build/git-server-ubuntu22.sh" />
    <None Include="scripts/build/zigcc-x86_64-gnu.sh" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Gapotchenko.FX.Console" Version="2026.8.3" />
  </ItemGroup>
  <Target Name="GenerateSelfBuildHashes" BeforeTargets="BeforeCompile">
    <Exec Command="dotnet fsi --exec &quot;$(MSBuildProjectDirectory)\scripts\genhashes.fsx&quot;" />
  </Target>
</Project>
