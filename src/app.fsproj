<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <LangVersion>10</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <None Include="index.html" />
    <None Include="index.css" />
    <Compile Include="bin/version.fs" />
    <Compile Include="src/common/AsyncOps.fs" />
    <Compile Include="src/common/Extensions.fs" />
    <Compile Include="src/interop/ReactVersion.fs" />
    <Compile Include="src/interop/Browser.fs" />
    <Compile Include="src/interop/FrontendLog.fs" />
    <Compile Include="src/tauri/Tauri.Dpi.fs" />
    <Compile Include="src/tauri/Tauri.Event.fs" />
    <Compile Include="src/tauri/Tauri.Window.fs" />
    <Compile Include="src/tauri/Tauri.fs" />
    <Compile Include="src/domain/GitProtocol.fs" />
    <Compile Include="src/domain/Workspace.fs" />
    <Compile Include="src/domain/CommitGraph.fs" />
    <Compile Include="src/tauri/AppTauri.fs" />
    <Compile Include="src/domain/ProjectData.fs" />
    <Compile Include="src/Debug.fs" />
    <Compile Include="src/State.fs" />
    <Compile Include="src/ui/ProjectMenu.fs" />
    <Compile Include="src/ui/SvgIcons.fs" />
    <Compile Include="src/ui/CommitFiles.fs" />
    <Compile Include="src/ui/CommitDiff.fs" />
    <Compile Include="src/ui/CommitGraph.fs" />
    <Compile Include="src/ui/RepositorySplitter.fs" />
    <Compile Include="src/ui/Branches.fs" />
    <Compile Include="src/ui/DesktopTabs.fs" />
    <Compile Include="src/ui/ProjectEditor.fs" />
    <Compile Include="src/ui/View.fs" />
    <Compile Include="src/Program.fs" />
  </ItemGroup>
  <!-- <ItemGroup>
    <PackageReference Include="Fable.Core" Version="4.5.0" />
    <PackageReference Include="Fable.Elmish" Version="5.0.2" />
    <PackageReference Include="Fable.Elmish.React" Version="5.0.1" />
    <PackageReference Include="Fable.Promise" Version="3.2.0" />
    <PackageReference Include="Feliz" Version="2.9.0" />
    <PackageReference Include="Feliz.DaisyUI" Version="5.2.0" />
    <PackageReference Include="Feliz.Router" Version="4.0.0" />
    <PackageReference Include="Thoth.Json" Version="10.4.1" />
    <PackageReference Include="Fable.Browser.Dom" Version="2.20.0" />
  </ItemGroup> -->
  <Target Name="PreBuild" BeforeTargets="PreBuildEvent">
    <Exec Command="dotnet fsi --exec &quot;$(MSBuildProjectDirectory)\..\build\scripts\version\version.fsx&quot; &quot;$(MSBuildThisFileDirectory)bin&quot;" />
  </Target>
  <Import Project="..\.paket\Paket.Restore.targets" />
</Project>
